    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "lucide-react": "^1.16.0",
    "motion": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
